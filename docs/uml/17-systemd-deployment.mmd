flowchart TB
    subgraph Session["user session systemd --user"]
        U_COMP["lumen-compositor.service"]
        U_SHELL["lumen-shell.service (session.slice)"]
        U_APP["app-lumen-ID@RANDOM.service (app.slice, transient)"]
        U_XDP["xdg-desktop-portal.service (frontend)"]
        U_PL["xdg-desktop-portal-lumen.service (Type=dbus)"]
        U_PW["xdg-desktop-portal-wlr.service (Type=dbus)"]
        ENV["manager environment:<br/>WAYLAND_DISPLAY, XDG_CURRENT_DESKTOP=Lumen"]
        SK_WL["XDG_RUNTIME_DIR/lumen-0"]
        SK_PRIV["lumen-compositor.private"]
    end

    subgraph FS["filesystem"]
        BIN["/usr/bin/lumen-compositor"]
        MOD["/usr/lib/lumen/modules"]
        THEMES["/usr/share/lumen/themes"]
        PROT["/usr/share/lumen/protocols"]
    end

    U_COMP --> SK_WL
    U_COMP --> SK_PRIV
    U_SHELL --> SK_WL
    U_SHELL --> SK_PRIV
