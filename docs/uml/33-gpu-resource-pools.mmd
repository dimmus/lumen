classDiagram
    class device {
        +pipelines() pipeline_cache
        +semaphores() timeline_semaphore_pool
    }
    class pipeline_cache {
        +acquire(pipeline_key) unsigned
        +hit_count() unsigned
    }
    class frame_renderer {
        +set_pipeline_cache(pipeline_cache)
        +draw_to_headless(blit_command[], headless_backend)
    }
    class timeline_semaphore_pool {
        +acquire(signal_value) handle
        +release(handle)
    }
    device --> pipeline_cache
    device --> timeline_semaphore_pool
    frame_renderer --> pipeline_cache : uses
