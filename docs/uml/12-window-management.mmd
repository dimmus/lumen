classDiagram
    direction TB

    class PolicyRegistry {
        +instance() PolicyRegistry&
        +active() WindowManagerPolicy&
    }

    class WindowManagerPolicy {
        <<interface>>
        +on_map(toplevel)
        +on_focus_changed(old, new)
        +on_geometry(toplevel, x, y, w, h)
    }

    class StackingPolicy

    class WindowManager {
        <<compositor>>
        +set_tiling_config(tiling_config)
        +toggle_layout(slot)
        +toggle_floating(toplevel)
        +flush_tiling()
    }
    class WorkspaceRecord {
        layout
        master_count
        master_ratio
    }
    class Tiling {
        <<pure>>
        +master_stack_layout(area, master_count, ratio, gaps, out)
    }

    WindowManagerPolicy <|-- StackingPolicy
    PolicyRegistry --> StackingPolicy
    WindowManager --> WorkspaceRecord : layout per workspace
    WindowManager ..> Tiling : ADR 012
