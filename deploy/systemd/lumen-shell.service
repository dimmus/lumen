[Unit]
Description=Lumen Desktop Shell
Documentation=https://github.com/lumen-desktop/lumen
Requires=lumen-compositor.service
After=lumen-compositor.service
PartOf=graphical-session.target

[Service]
Type=simple
# Essential to the graphical session (systemd.io/DESKTOP_ENVIRONMENTS). The applications it
# launches are not its children: each runs as app-lumen-<id>@<random>.service in app.slice.
Slice=session.slice
ExecStart=%bindir%/lumen-shell
Restart=on-failure
RestartSec=1
Environment=WAYLAND_DISPLAY=lumen-0
Environment=XDG_CURRENT_DESKTOP=Lumen

[Install]
WantedBy=graphical-session.target
