[Unit]
Description=Lumen Wayland Compositor
Documentation=https://github.com/lumen-desktop/lumen
After=graphical-session-pre.target
Wants=graphical-session-pre.target

[Service]
Type=simple
ExecStart=%bindir%/lumen-compositor
Restart=on-failure
RestartSec=1
Environment=WAYLAND_DISPLAY=lumen-0
Environment=XDG_CURRENT_DESKTOP=Lumen

[Install]
WantedBy=graphical-session.target
