+impl PidFd {
+    pub fn open(pid: libc::pid_t) -> Result<Self, Error> {
+        let fd = unsafe { libc::syscall(libc::SYS_pidfd_open, pid, 0u32) };
+        if fd < 0 {
+            return Err(io::Error::last_os_error().into());
+        }
+        Ok(Self(unsafe { OwnedFd::from_raw_fd(fd as RawFd) }))
+    }
+
+    pub fn open_child(pid: libc::pid_t, parent: libc::pid_t) -> Result<Self, Error> {
+        let handle = Self::open(pid)?;
+        let status = fs::read_to_string(format!("/proc/{}/status", pid))?;
+        let actual = status
+            .lines()
+            .find_map(|line| line.strip_prefix("PPid:"))
+            .and_then(|value| value.trim().parse().ok());
+        handle.alive()?;
+        if actual != Some(parent) {
+            return Err("split VT: command is no longer a child of the PAM worker".into());
+        }
+        Ok(handle)
+    }
+
+    fn from_peer(stream: &UnixStream) -> Result<Self, Error> {
+        let mut fd: RawFd = -1;
+        let mut len = std::mem::size_of_val(&fd) as libc::socklen_t;
+        if unsafe {
+            libc::getsockopt(
+                stream.as_raw_fd(),
+                libc::SOL_SOCKET,
+                SO_PEERPIDFD,
+                (&mut fd as *mut RawFd).cast(),
+                &mut len,
+            )
+        } < 0
+        {
+            return Err(format!(
+                "split VT requires SO_PEERPIDFD: {}",
+                io::Error::last_os_error()
+            )
+            .into());
+        }
+        if fd < 0 {
+            return Err("split VT: invalid peer pidfd".into());
+        }
+        let peer = Self(unsafe { OwnedFd::from_raw_fd(fd) });
+        if len as usize != std::mem::size_of::<RawFd>() {
+            return Err("split VT: invalid SO_PEERPIDFD result length".into());
+        }
+        Ok(peer)
+    }
+
+    pub fn match_peer(
+        &self,
+        stream: &UnixStream,
+        pid: libc::pid_t,
+        uid: libc::uid_t,
+    ) -> Result<Self, Error> {
+        self.alive()?;
+        let cred = stream.peer_cred()?;
+        if pid <= 0 || cred.pid() != Some(pid) || cred.uid() != uid {
+            return Err("split VT: presentation peer is not the tracked greeter command".into());
+        }
+        let peer = Self::from_peer(stream)?;
+        // Both kernel handles must still be live for the same numeric PID in
+        // this namespace. Bracket the peer check so PID reuse cannot match.
+        peer.alive()?;
+        self.alive()?;
+        Ok(peer)
+    }
+
+    pub fn alive(&self) -> Result<(), Error> {
+        let mut fd = libc::pollfd {
+            fd: self.0.as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        };
+        match unsafe { libc::poll(&mut fd, 1, 0) } {
+            0 => Ok(()),
+            -1 => Err(io::Error::last_os_error().into()),
+            _ => Err("split VT: tracked process has exited".into()),
+        }
+    }
+
+    pub async fn exited(&self) {
+        while self.alive().is_ok() {
+            sleep(CHECK_INTERVAL).await;
+        }
+    }
+
+    pub fn signal(&self, signal: libc::c_int) {
+        unsafe {
+            libc::syscall(
+                libc::SYS_pidfd_send_signal,
+                self.0.as_raw_fd(),
+                signal,
+                std::ptr::null::<libc::siginfo_t>(),
+                0u32,
+            )
+        };
+    }
+}
+
+pub struct Peer {
+    pid: libc::pid_t,
+    pub uid: u32,
+    path: String,
+    pub fd: PidFd,
+}
+
+impl Peer {
+    pub fn verify(&self, pam: &logind::Session) -> Result<(), Error> {
+        self.check()?;
+        verify_peer(self.pid, self.uid, &self.path, pam)?;
+        self.check()
+    }
+
+    pub async fn recheck(&self, pam: &logind::Session) -> Result<(), Error> {
+        self.check()?;
+        let (pid, uid) = (self.pid, self.uid);
+        let (path, pam) = (self.path.clone(), pam.clone());
+        tokio::task::spawn_blocking(move || verify_peer(pid, uid, &path, &pam))
+            .await
+            .map_err(|e| e.to_string())??;
+        self.check()
+    }
+
+    pub fn check(&self) -> Result<(), Error> {
+        self.fd
+            .alive()
+            .map_err(|e| format!("compositor {}: {}", self.pid, e).into())
+    }
+}
+
+async fn read_message(stream: &mut UnixStream, expected: &[u8]) -> Result<(), Error> {
+    let mut buf = [0; 43];
+    stream.read_exact(&mut buf[..expected.len()]).await?;
+    if &buf[..expected.len()] != expected {
+        return Err("split VT: unexpected handoff message".into());
+    }
+    Ok(())
+}
+
+#[derive(Clone)]
+pub struct ReturnRequest(Arc<ReturnState>);
+
+struct ReturnState {
+    fd: OwnedFd,
+    deadline: Instant,
+    cancelled: AtomicBool,
+}
+
+impl ReturnRequest {
+    pub fn check(&self) -> Result<(), Error> {
+        if self.0.cancelled.load(Ordering::Acquire) || Instant::now() >= self.0.deadline {
+            return Err("split VT RETURN expired or cancelled".into());
+        }
+        // Check the actual socket from inside the blocking activation guard, where
+        // the Tokio read half may not yet have observed a hangup or extra bytes.
+        let mut byte = 0u8;
+        let received = unsafe {
+            libc::recv(
+                self.0.fd.as_raw_fd(),
+                (&mut byte as *mut u8).cast(),
+                1,
+                libc::MSG_DONTWAIT | libc::MSG_PEEK,
+            )
+        };
+        if received < 0 && io::Error::last_os_error().kind() == io::ErrorKind::WouldBlock {
+            return Ok(());
+        }
+        Err("split VT RETURN peer disconnected or sent extra data".into())
+    }
+}
+
+struct ReturnScope(ReturnRequest);
+
+impl Drop for ReturnScope {
+    fn drop(&mut self) {
+        self.0 .0.cancelled.store(true, Ordering::Release);
+        // The guard held by a blocking logind call may still own the duplicate.
+        unsafe { libc::shutdown(self.0 .0.fd.as_raw_fd(), libc::SHUT_RDWR) };
+    }
+}
+
+pub async fn return_exchange<F>(
+    mut stream: UnixStream,
+    activate: impl FnOnce(ReturnRequest) -> F,
+) -> Result<bool, Error>
+where
+    F: Future<Output = Result<(), Error>>,
+{
+    let mut first = [0u8; 1];
+    if stream.read(&mut first).await? == 0 {
+        return Ok(false);
+    }
+    if first[0] != b'R' {
+        return Err("split VT: expected RETURN".into());
+    }
+    let deadline = Instant::now() + RETURN_TIMEOUT;
+    timeout_at(deadline.into(), read_message(&mut stream, b"ETURN\n"))
+        .await
+        .map_err(|_| Error::from("split VT RETURN record timed out"))??;
+    let fd = unsafe { libc::fcntl(stream.as_raw_fd(), libc::F_DUPFD_CLOEXEC, 0) };
+    if fd < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    let scope = ReturnScope(ReturnRequest(Arc::new(ReturnState {
+        fd: unsafe { OwnedFd::from_raw_fd(fd) },
+        deadline,
+        cancelled: AtomicBool::new(false),
+    })));
+    let (mut read, mut write) = stream.split();
+    timeout_at(deadline.into(), async {
+        tokio::select! {
+            biased;
+            _ = read.read_u8() => Err("split VT RETURN peer disconnected or sent extra data".into()),
+            result = async {
+                scope.0.check()?;
+                activate(scope.0.clone()).await?;
+                scope.0.check()?;
+                write.write_all(b"RETURNED\n").await?;
+                Ok(true)
+            } => result,
+        }
+    }).await.map_err(|_| Error::from("split VT RETURN timed out"))?
+}
+
+pub fn require_foreground(vt: usize, pam: &logind::Session) -> Result<(), Error> {
+    logind::require_exclusive_vt(vt, pam)?;
+    if !pam.active()? || foreground()? != vt {
+        return Err("split VT: expected PAM session is no longer in the foreground".into());
+    }
+    Ok(())
+}
+
+pub fn graphics(vt: usize) -> Result<bool, Error> {
+    Terminal::open(&format!("/dev/tty{}", vt))?.kd_is_graphics()
+}
+
+pub async fn wait_active(vt: usize, pam: &logind::Session) -> Result<(), Error> {
+    loop {
+        if foreground()? == vt && pam.active()? {
+            return require_foreground(vt, pam);
+        }
+        sleep(CHECK_INTERVAL).await;
+    }
+}
+
+async fn challenge(stream: &mut UnixStream, nonce: &str) -> Result<(), Error> {
+    stream
+        .write_all(format!("ACTIVE {}\n", nonce).as_bytes())
+        .await?;
+    read_message(stream, format!("PRESENTED {}\n", nonce).as_bytes()).await
+}
+
+pub async fn wait_foreground_change(greeter: usize, user: Option<usize>) -> Error {
+    loop {
+        match foreground() {
+            Ok(vt) if vt == greeter || user == Some(vt) => {}
+            Ok(_) => return "split VT: operator changed foreground VT".into(),
+            Err(e) => return e,
+        }
+        sleep(CHECK_INTERVAL).await;
+    }
+}
+
+const ROLLBACK_OBSERVE: Duration = Duration::from_millis(500);
+
+#[derive(Debug, PartialEq, Eq)]
+enum ForegroundAfterSwitch {
+    Source,
+    Target,
+    Other,
+}
+
+async fn observe_late_switch(
+    mut foreground: impl FnMut() -> Result<usize, Error>,
+    source: usize,
+    target: usize,
+    limit: Duration,
+) -> Result<ForegroundAfterSwitch, Error> {
+    let deadline = tokio::time::Instant::now() + limit;
+    loop {
+        let vt = foreground()?;
+        if vt != source {
+            return Ok(if vt == target {
+                ForegroundAfterSwitch::Target
+            } else {
+                ForegroundAfterSwitch::Other
+            });
+        }
+        let now = tokio::time::Instant::now();
+        if now >= deadline {
+            return Ok(ForegroundAfterSwitch::Source);
+        }
+        sleep(CHECK_INTERVAL.min(deadline - now)).await;
+    }
+}
+
+pub async fn observe_rollback(vts: &Vts) -> Result<bool, Error> {
+    Ok(
+        observe_late_switch(foreground, vts.greeter, vts.user, ROLLBACK_OBSERVE).await?
+            == ForegroundAfterSwitch::Target,
+    )
+}
+
+#[derive(Default)]
+pub struct Switch {
+    cancelled: Mutex<bool>,
+    requested: AtomicBool,
+    foreground_lost: AtomicBool,
+}
+
+impl Switch {
+    pub fn inhibit_restore(&self) {
+        self.foreground_lost.store(true, Ordering::Release);
+    }
+
+    pub async fn cancel(self: Arc<Self>) -> bool {
+        tokio::task::spawn_blocking(move || {
+            *self.cancelled.lock().unwrap() = true;
+            self.requested() && !self.foreground_lost.load(Ordering::Acquire)
+        })
+        .await
+        .unwrap_or(false)
+    }
+
+    pub fn requested(&self) -> bool {
+        self.requested.load(Ordering::Acquire)
+    }
+
+    pub async fn activate(
+        self: Arc<Self>,
+        session: logind::Session,
+        guard: impl FnOnce(&logind::Session) -> Result<(), Error> + Send + 'static,
+    ) -> Result<(), Error> {
+        tokio::task::spawn_blocking(move || {
+            let cancelled = self.cancelled.lock().unwrap();
+            // Keep cancellation serialized with the checked blocking call.
+            session.activate_if(|| {
+                if *cancelled || self.foreground_lost.load(Ordering::Acquire) {
+                    return Err("split VT: switch cancelled before activation".into());
+                }
+                guard(&session)?;
+                if self.foreground_lost.load(Ordering::Acquire) {
+                    return Err("split VT: foreground changed before activation".into());
+                }
+                // A bus timeout is not evidence that the request was not delivered.
+                self.requested.store(true, Ordering::Release);
+                Ok(())
+            })
+        })
+        .await
+        .map_err(|e| e.to_string())?
+    }
+
+    pub async fn allow_return_recovery(self: Arc<Self>, vts: &Vts) -> Result<bool, Error> {
+        let observe =
+            self.clone()
+                .reconcile_return(foreground, vts.user, vts.greeter, ROLLBACK_OBSERVE);
+        tokio::select! {
+            biased;
+            _ = wait_foreground_change(vts.user, Some(vts.greeter)) => {
+                self.inhibit_restore();
+                self.cancel().await;
+                Ok(false)
+            }
+            result = observe => result,
+        }
+    }
+
+    async fn reconcile_return(
+        self: Arc<Self>,
+        mut foreground: impl FnMut() -> Result<usize, Error>,
+        source: usize,
+        target: usize,
+        limit: Duration,
+    ) -> Result<bool, Error> {
+        let requested = self.clone().cancel().await;
+        if self.foreground_lost.load(Ordering::Acquire) {
+            return Ok(false);
+        }
+        if !requested {
+            return Ok(foreground()? == source);
+        }
+        // Never repeat an already-requested switch that reached its destination.
+        Ok(
+            observe_late_switch(foreground, source, target, limit).await?
+                == ForegroundAfterSwitch::Source,
+        )
+    }
+}
+
+pub fn require_active(vts: &Vts, pam: &logind::Session) -> Result<(), Error> {
+    require_foreground(vts.user, pam)
+}
+
+pub async fn presented(
+    stream: &mut UnixStream,
+    vts: &Vts,
+    pam: &logind::Session,
+    switch: Arc<Switch>,
+) -> Result<(), Error> {
+    let greeter_vt = vts.greeter;
+    let user_vt = vts.user;
+    switch
+        .activate(pam.clone(), move |session| {
+            logind::require_exclusive_vt(user_vt, session)?;
+            if !Terminal::open(&format!("/dev/tty{}", user_vt))?.kd_is_graphics()? {
+                return Err("split VT: target is not in KD_GRAPHICS".into());
+            }
+            if session.active()? || foreground()? != greeter_vt {
+                return Err("split VT: cannot activate after the foreground changed".into());
+            }
+            Ok(())
+        })
+        .await?;
+
+    // The bus reply can arrive before the kernel completes the VT switch.
+    wait_active(user_vt, pam).await?;
+    challenge(stream, &random_nonce()?).await?;
+    require_active(vts, pam)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn split_request_is_versioned_and_pinned() {
+        assert!(check_request(1, &[], &[]).is_ok());
+        assert!(check_request(1, &[COMMAND.into()], &[]).is_ok());
+        assert!(check_request(0, &[], &[]).is_err());
+        assert!(check_request(1, &["lumen-session".into()], &[]).is_err());
+        assert!(check_request(1, &[COMMAND.into(), "; true".into()], &[]).is_err());
+        assert!(check_request(1, &[], &["LUMEN_DM_HANDOFF=/tmp/no".into()]).is_err());
+    }
+
+    #[tokio::test]
+    async fn rollback_observes_late_activation_and_latches_third_vt() {
+        for (vts, expected) in [
+            (vec![1, 1, 7], ForegroundAfterSwitch::Target),
+            (vec![1, 3, 7], ForegroundAfterSwitch::Other),
+            (vec![1], ForegroundAfterSwitch::Source),
+        ] {
+            let last = *vts.last().unwrap();
+            let mut vts = vts.into_iter();
+            assert_eq!(
+                observe_late_switch(
+                    || Ok(vts.next().unwrap_or(last)),
+                    1,
+                    7,
+                    Duration::from_millis(150)
+                )
+                .await
+                .unwrap(),
+                expected
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn cancelled_return_reconciles_a_delivered_request_without_stealing_vt() {
+        for (vts, allowed) in [(vec![7, 1], false), (vec![7, 3, 7], false), (vec![7], true)] {
+            let switch = Arc::new(Switch::default());
+            switch.requested.store(true, Ordering::Release);
+            let last = *vts.last().unwrap();
+            let mut vts = vts.into_iter();
+            assert_eq!(
+                switch
+                    .reconcile_return(
+                        || Ok(vts.next().unwrap_or(last)),
+                        7,
+                        1,
+                        Duration::from_millis(60)
+                    )
+                    .await
+                    .unwrap(),
+                allowed
+            );
+        }
+        let switch = Arc::new(Switch::default());
+        switch.inhibit_restore();
+        assert!(!switch
+            .reconcile_return(|| Ok(7), 7, 1, Duration::ZERO)
+            .await
+            .unwrap());
+    }
+
+    #[tokio::test]
+    async fn greeter_presentation_checks_kernel_peer_credentials_and_live_pidfd() {
+        let (_peer, broker) = UnixStream::pair().unwrap();
+        let (pid, uid) = unsafe { (libc::getpid(), libc::geteuid()) };
+        let command = PidFd::open(pid).unwrap();
+        assert!(command.match_peer(&broker, pid, uid).is_ok());
+        assert!(command.match_peer(&broker, pid, uid ^ 1).is_err());
+        let mut other = std::process::Command::new("/bin/sleep")
+            .arg("60")
+            .spawn()
+            .unwrap();
+        let other_pid = other.id() as libc::pid_t;
+        let other_command = PidFd::open(other_pid).unwrap();
+        let different_peer = other_command.match_peer(&broker, other_pid, uid);
+        other.kill().unwrap();
+        other.wait().unwrap();
+        assert!(different_peer.is_err());
+        assert!(other_command.alive().is_err());
+        assert!(other_command.match_peer(&broker, other_pid, uid).is_err());
+    }
+
+    #[tokio::test]
+    async fn stale_presentation_cannot_answer_fresh_activation() {
+        let (mut client, mut daemon) = UnixStream::pair().unwrap();
+        let stale = "00112233445566778899aabbccddeeff";
+        let fresh = "ffeeddccbbaa99887766554433221100";
+        client
+            .write_all(format!("PRESENTED {}\n", stale).as_bytes())
+            .await
+            .unwrap();
+        assert!(challenge(&mut daemon, fresh).await.is_err());
+        read_message(&mut client, format!("ACTIVE {}\n", fresh).as_bytes())
+            .await
+            .unwrap();
+
+        let (mut client, mut daemon) = UnixStream::pair().unwrap();
+        let (accepted, ()) = tokio::join!(challenge(&mut daemon, fresh), async {
+            read_message(&mut client, format!("ACTIVE {}\n", fresh).as_bytes())
+                .await
+                .unwrap();
+            client
+                .write_all(format!("PRESENTED {}\n", fresh).as_bytes())
+                .await
+                .unwrap();
+        });
+        assert!(accepted.is_ok());
+    }
+
+    #[tokio::test]
+    async fn return_ack_waits_for_presentation_even_after_activation() {
+        let (mut client, broker) = UnixStream::pair().unwrap();
+        let (activated_tx, activated_rx) = tokio::sync::oneshot::channel();
+        let (presented_tx, presented_rx) = tokio::sync::oneshot::channel();
+        let exchange = return_exchange(broker, |request| async move {
+            request.check()?;
+            activated_tx.send(()).unwrap();
+            presented_rx.await.unwrap();
+            request.check()
+        });
+        let client_side = async {
+            client.write_all(b"RET").await.unwrap();
+            client.write_all(b"URN\n").await.unwrap();
+            activated_rx.await.unwrap();
+            assert_eq!(
+                client.try_read(&mut [0]).unwrap_err().kind(),
+                io::ErrorKind::WouldBlock
+            );
+            presented_tx.send(()).unwrap();
+            read_message(&mut client, b"RETURNED\n").await.unwrap();
+            assert_eq!(client.read(&mut [0]).await.unwrap(), 0);
+        };
+        let (result, ()) = tokio::join!(exchange, client_side);
+        assert!(result.unwrap());
+    }
+
+    #[tokio::test]
+    async fn return_rejects_duplicate_and_malformed_requests() {
+        for invalid in [b"RETURN\nRETURN\n".as_slice(), b"RETURNx".as_slice()] {
+            let (mut client, broker) = UnixStream::pair().unwrap();
+            client.write_all(invalid).await.unwrap();
+            assert!(return_exchange(broker, |_| async {
+                panic!("invalid RETURN reached activation")
+            })
+            .await
+            .is_err());
+            match client.read(&mut [0]).await {
+                Ok(0) => {}
+                Err(e) if e.kind() == io::ErrorKind::ConnectionReset => {}
+                result => panic!("invalid RETURN did not close the stream: {:?}", result),
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn return_hangup_cancels_inflight_guard() {
+        let (mut client, broker) = UnixStream::pair().unwrap();
+        let (guard_tx, guard_rx) = tokio::sync::oneshot::channel();
+        let exchange = return_exchange(broker, |request| async move {
+            request.check()?;
+            assert!(guard_tx.send(request).is_ok());
+            std::future::pending::<Result<(), Error>>().await
+        });
+        let client_side = async {
+            client.write_all(b"RETURN\n").await.unwrap();
+            let request = guard_rx.await.unwrap();
+            drop(client);
+            request
+        };
+        let (result, request) = tokio::join!(exchange, client_side);
+        assert!(result.is_err());
+        assert!(request.check().is_err());
+    }
+
+    #[tokio::test]
+    async fn handoff_records_are_exact_and_ordered() {
+        use tokio::io::AsyncWriteExt;
+        let (mut client, mut daemon) = UnixStream::pair().unwrap();
+        client.write_all(b"PREPARED\nPRESENTED\n").await.unwrap();
+        read_message(&mut daemon, b"PREPARED\n").await.unwrap();
+        read_message(&mut daemon, b"PRESENTED\n").await.unwrap();
+        let (mut client, mut daemon) = UnixStream::pair().unwrap();
+        client.write_all(b"PRESENTED\n").await.unwrap();
+        assert!(read_message(&mut daemon, b"PREPARED\n").await.is_err());
+        drop(client);
+        assert!(read_message(&mut daemon, b"PRESENTED\n").await.is_err());
+    }
+}
