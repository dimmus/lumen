+                inner
+                    .pending_split
+                    .as_ref()
+                    .unwrap()
+                    .abort
+                    .send_replace(true);
+                return;
+            } else if inner
+                .active_split
+                .as_ref()
+                .map_or(false, |s| s.child.owns_pid(pid))
+            {
+                let active = inner.active_split.take().unwrap();
+                active.binding.peer.fd.signal(libc::SIGTERM);
+                drop(active.return_alive);
+                if inner.recovering_split {
+                    return;
+                }
+                inner.recovering_split = true;
+                Some(Some((active.binding, active.return_recovery)))
+            } else {
+                // Authentication failures are reported over the internal socket to
+                // the auth handler; do not discard its buffered error here.
+                None
+            }
+        };
+        if let Some(recovery) = recovery {
+            let ctx = self.clone();
+            tokio::task::spawn_local(async move {
+                if let Some((desktop, reconciled)) = recovery {
+                    let owner = reconciled
+                        .await
+                        .unwrap_or(false)
+                        .then(|| desktop.pam.clone());
+                    if let Some(vts) = &ctx.split_vts {
+                        ctx.finish_split_recovery(vts, owner).await;
+                    }
+                } else {
+                    ctx.recover_split(None).await;
+                }
+            });
+        }
+    }
