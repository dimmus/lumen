+//! Narrow systemd interfaces for the split VT path. No user-supplied D-Bus targets.
+use std::{
+    ffi::{CStr, CString},
+    io,
+    os::raw::{c_char, c_int, c_void},
+    ptr,
+};
+
+use crate::error::Error;
+
+type BusPtr = *mut c_void;
+
+#[link(name = "systemd")]
+extern "C" {
+    fn sd_bus_open_system(ret: *mut BusPtr) -> c_int;
+    fn sd_bus_new(ret: *mut BusPtr) -> c_int;
+    fn sd_bus_set_address(bus: BusPtr, address: *const c_char) -> c_int;
+    fn sd_bus_start(bus: BusPtr) -> c_int;
+    fn sd_bus_get_fd(bus: BusPtr) -> c_int;
+    fn sd_bus_set_method_call_timeout(bus: BusPtr, usec: u64) -> c_int;
+    fn sd_bus_unref(bus: BusPtr) -> BusPtr;
+    fn sd_bus_get_property_trivial(
+        bus: BusPtr,
+        dest: *const c_char,
+        path: *const c_char,
+        interface: *const c_char,
+        member: *const c_char,
+        error: BusPtr,
+        ty: c_char,
+        ret: *mut c_void,
+    ) -> c_int;
+    fn sd_bus_call_method(
+        bus: BusPtr,
+        dest: *const c_char,
+        path: *const c_char,
+        interface: *const c_char,
+        member: *const c_char,
+        error: BusPtr,
+        reply: *mut BusPtr,
+        types: *const c_char,
+        ...
+    ) -> c_int;
+    fn sd_pid_get_session(pid: libc::pid_t, ret: *mut *mut c_char) -> c_int;
+    fn sd_pid_get_owner_uid(pid: libc::pid_t, ret: *mut libc::uid_t) -> c_int;
+    fn sd_pid_get_user_unit(pid: libc::pid_t, ret: *mut *mut c_char) -> c_int;
+    fn sd_session_get_uid(id: *const c_char, ret: *mut libc::uid_t) -> c_int;
+    fn sd_session_get_vt(id: *const c_char, ret: *mut libc::c_uint) -> c_int;
+    fn sd_session_get_seat(id: *const c_char, ret: *mut *mut c_char) -> c_int;
+    fn sd_session_is_active(id: *const c_char) -> c_int;
+    fn sd_seat_get_sessions(
+        seat: *const c_char,
+        ids: *mut *mut *mut c_char,
+        uids: *mut *mut libc::uid_t,
+        n_uids: *mut libc::c_uint,
+    ) -> c_int;
+}
+
+fn check(status: c_int) -> Result<c_int, Error> {
+    if status < 0 {
+        return Err(io::Error::from_raw_os_error(-status).into());
+    }
+    Ok(status)
+}
+
+fn allocated(f: impl FnOnce(*mut *mut c_char) -> c_int) -> Result<CString, Error> {
+    let mut data = ptr::null_mut();
+    check(f(&mut data))?;
+    let value = unsafe { CStr::from_ptr(data).to_owned() };
+    unsafe { libc::free(data.cast()) };
+    Ok(value)
+}
+
+struct Bus(BusPtr);
+
+impl Drop for Bus {
+    fn drop(&mut self) {
+        unsafe { sd_bus_unref(self.0) };
+    }
+}
+
+impl Bus {
+    fn system() -> Result<Self, Error> {
+        let mut bus = Self(ptr::null_mut());
+        check(unsafe { sd_bus_open_system(&mut bus.0) })?;
+        check(unsafe { sd_bus_set_method_call_timeout(bus.0, 500_000) })?;
+        Ok(bus)
+    }
+
+    fn user_manager(uid: libc::uid_t, manager_pid: u32) -> Result<Self, Error> {
+        let mut bus = Self(ptr::null_mut());
+        let address = CString::new(format!("unix:path=/run/user/{}/systemd/private", uid))?;
+        check(unsafe { sd_bus_new(&mut bus.0) })?;
+        check(unsafe { sd_bus_set_address(bus.0, address.as_ptr()) })?;
+        check(unsafe { sd_bus_set_method_call_timeout(bus.0, 500_000) })?;
+        check(unsafe { sd_bus_start(bus.0) })?;
+        let fd = check(unsafe { sd_bus_get_fd(bus.0) })?;
+        let mut cred = libc::ucred {
+            pid: 0,
+            uid: 0,
+            gid: 0,
+        };
+        let mut len = std::mem::size_of_val(&cred) as libc::socklen_t;
+        if unsafe {
+            libc::getsockopt(
+                fd,
+                libc::SOL_SOCKET,
+                libc::SO_PEERCRED,
+                (&mut cred as *mut libc::ucred).cast(),
+                &mut len,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error().into());
+        }
+        if cred.uid != uid || cred.pid as u32 != manager_pid || manager_pid == 0 {
+            return Err("split VT: unexpected systemd user manager peer".into());
+        }
+        Ok(bus)
+    }
+
+    fn main_pid(&self, unit_path: &CStr, private: bool) -> Result<u32, Error> {
+        let dest = if private {
+            ptr::null()
+        } else {
+            cstr!("org.freedesktop.systemd1").as_ptr()
+        };
+        let mut pid: u32 = 0;
+        check(unsafe {
+            sd_bus_get_property_trivial(
+                self.0,
+                dest,
+                unit_path.as_ptr(),
+                cstr!("org.freedesktop.systemd1.Service").as_ptr(),
+                cstr!("MainPID").as_ptr(),
+                ptr::null_mut(),
+                b'u' as c_char,
+                (&mut pid as *mut u32).cast(),
+            )
+        })?;
+        Ok(pid)
+    }
+}
+
+pub fn verify_service(pid: libc::pid_t, uid: libc::uid_t) -> Result<(), Error> {
+    let mut owner = 0;
+    check(unsafe { sd_pid_get_owner_uid(pid, &mut owner) })?;
+    let unit = allocated(|ret| unsafe { sd_pid_get_user_unit(pid, ret) })?;
+    if owner != uid || unit.as_c_str() != cstr!("lumen-compositor.service") {
+        return Err("split VT: compositor peer is outside the user unit".into());
+    }
+    let system_unit = CString::new(format!(
+        "/org/freedesktop/systemd1/unit/user_40{}_2eservice",
+        uid
+    ))?;
+    let manager = Bus::system()?.main_pid(&system_unit, false)?;
+    let user_bus = Bus::user_manager(uid, manager)?;
+    let main = user_bus.main_pid(
+        cstr!("/org/freedesktop/systemd1/unit/lumen_2dcompositor_2eservice"),
+        true,
+    )?;
+    if pid as u32 != main {
+        return Err("split VT: compositor peer is not the service MainPID".into());
+    }
+    Ok(())
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Session(CString);
+
+impl Session {
+    pub fn from_worker(pid: libc::pid_t, uid: libc::uid_t, vt: usize) -> Result<Self, Error> {
+        Self::try_from_worker(pid, uid, vt)?
+            .ok_or_else(|| "split VT: worker has no PAM session".into())
+    }
+
+    pub fn try_from_worker(
+        pid: libc::pid_t,
+        uid: libc::uid_t,
+        vt: usize,
+    ) -> Result<Option<Self>, Error> {
+        let mut missing = false;
+        let id = allocated(|ret| {
+            let status = unsafe { sd_pid_get_session(pid, ret) };
+            missing = status == -libc::ENODATA || status == -libc::ENXIO;
+            status
+        });
+        if missing {
+            return Ok(None);
+        }
+        let id = id?;
+        let seat = allocated(|ret| unsafe { sd_session_get_seat(id.as_ptr(), ret) })?;
+        let mut actual_uid = 0;
+        let mut actual_vt = 0;
+        check(unsafe { sd_session_get_uid(id.as_ptr(), &mut actual_uid) })?;
+        check(unsafe { sd_session_get_vt(id.as_ptr(), &mut actual_vt) })?;
+        if actual_uid != uid || seat.as_c_str() != cstr!("seat0") || actual_vt as usize != vt {
+            return Err(
+                "split VT: PAM session does not match the expected UID, seat and VT".into(),
+            );
+        }
+        Ok(Some(Self(id)))
+    }
+
+    pub fn id(&self) -> &[u8] {
+        self.0.as_bytes()
+    }
+
+    pub fn active(&self) -> Result<bool, Error> {
+        Ok(check(unsafe { sd_session_is_active(self.0.as_ptr()) })? > 0)
+    }
+
+    pub fn activate_if(&self, guard: impl FnOnce() -> Result<(), Error>) -> Result<(), Error> {
+        let bus = Bus::system()?;
+        guard()?;
+        self.call(&bus, cstr!("ActivateSession"))
+    }
+
+    pub fn terminate(&self) -> Result<(), Error> {
+        self.call(&Bus::system()?, cstr!("TerminateSession"))
+    }
+
+    fn call(&self, bus: &Bus, method: &CStr) -> Result<(), Error> {
+        check(unsafe {
+            sd_bus_call_method(
+                bus.0,
+                cstr!("org.freedesktop.login1").as_ptr(),
+                cstr!("/org/freedesktop/login1").as_ptr(),
+                cstr!("org.freedesktop.login1.Manager").as_ptr(),
+                method.as_ptr(),
+                ptr::null_mut(),
+                ptr::null_mut(),
+                cstr!("s").as_ptr(),
+                self.0.as_ptr(),
+            )
+        })?;
+        Ok(())
+    }
+}
+
+pub fn vt_is_occupied(vt: usize) -> Result<bool, Error> {
+    vt_has_other_session(vt, None)
+}
+
+pub fn vt_has_other_session(vt: usize, allowed: Option<&Session>) -> Result<bool, Error> {
+    Ok(vt_sessions(vt, allowed)?.other)
+}
+
+pub fn require_exclusive_vt(vt: usize, owner: &Session) -> Result<(), Error> {
+    let claims = vt_sessions(vt, Some(owner))?;
+    match claims {
+        VtClaims {
+            owner: true,
+            other: false,
+        } => Ok(()),
+        _ => Err("split VT: target does not belong exclusively to the pending PAM session".into()),
+    }
+}
+
+#[derive(Default)]
+struct VtClaims {
+    owner: bool,
+    other: bool,
+}
+
+fn session_vt(status: c_int, number: libc::c_uint) -> Result<Option<usize>, Error> {
+    match -status {
+        // sd-login uses ENXIO for a session that disappeared after enumeration and
+        // ENODATA for a session with no VT. An explicit zero also denotes no VT.
+        libc::ENXIO | libc::ENODATA => Ok(None),
+        _ => Ok((check(status)? >= 0 && number != 0).then_some(number as usize)),
+    }
+}
+
+fn vt_sessions(vt: usize, allowed: Option<&Session>) -> Result<VtClaims, Error> {
+    let mut ids = ptr::null_mut();
+    let count = check(unsafe {
+        sd_seat_get_sessions(
+            cstr!("seat0").as_ptr(),
+            &mut ids,
+            ptr::null_mut(),
+            ptr::null_mut(),
+        )
+    })? as usize;
+    let mut claims = VtClaims::default();
+    let mut error = None;
+    for i in 0..count {
+        unsafe {
+            let id = *ids.add(i);
+            let mut number = 0;
+            let status = sd_session_get_vt(id, &mut number);
+            match session_vt(status, number) {
+                Ok(Some(number)) if number == vt => {
+                    if allowed.is_some_and(|s| s.id() == CStr::from_ptr(id).to_bytes()) {
+                        claims.owner = true;
+                    } else {
+                        claims.other = true;
+                    }
+                }
+                Err(e) => {
+                    error.get_or_insert(e);
+                }
+                _ => {}
+            }
+            libc::free(id.cast());
+        }
+    }
+    unsafe { libc::free(ids.cast()) };
+    match error {
+        Some(e) => Err(e),
+        None => Ok(claims),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn vt_lookup_only_ignores_missing_sessions_and_unassigned_vts() {
+        assert_eq!(session_vt(-libc::ENODATA, 0).unwrap(), None);
+        assert_eq!(session_vt(-libc::ENXIO, 0).unwrap(), None);
+        assert_eq!(session_vt(0, 0).unwrap(), None);
+        assert_eq!(session_vt(0, 7).unwrap(), Some(7));
+        assert!(session_vt(-libc::EIO, 0).is_err());
+        assert!(session_vt(-libc::EACCES, 0).is_err());
+    }
+}
