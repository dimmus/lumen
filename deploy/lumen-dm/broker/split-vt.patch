+    pub async fn greeter_presented(&self, version: u32, stream: &UnixStream) -> Result<(), Error> {
+        if version != 1 {
+            return Err("unsupported split VT greeter presentation version".into());
+        }
+        let vts = self.split_vts.as_ref().ok_or("split VT is not enabled")?;
+        let (greeter, pam, request, attempt, peer) = {
+            let inner = self.inner.read().await;
+            let active = inner
+                .active_split
+                .as_ref()
+                .ok_or("split VT: no pending RETURN")?;
+            let pending = active
+                .return_presentation
+                .as_ref()
+                .ok_or("split VT: no pending greeter presentation")?;
+            let attempt = &active.binding.return_switch;
+            if !attempt.requested() {
+                return Err("split VT: return activation has not been requested".into());
+            }
+            pending.request.check()?;
+            vts.require_greeter()?;
+            let greeter = &pending.greeter;
+            let peer = greeter.command.match_peer(
+                stream,
+                greeter.command_pid.as_raw(),
+                vts.greeter_uid,
+            )?;
+            (
+                greeter.clone(),
+                pending.pam.clone(),
+                pending.request.clone(),
+                attempt.clone(),
+                peer,
+            )
+        };
+        // Logind can publish Active=yes after the KMS completion.
+        loop {
+            request.check()?;
+            vts.require_greeter()?;
+            greeter.check()?;
+            peer.alive()?;
+            if pam.active()? {
+                break;
+            }
+            sleep(Duration::from_millis(25)).await;
+        }
+        let mut inner = self.inner.write().await;
+        let current = inner
+            .current
+            .as_ref()
+            .and_then(|slot| slot.split_greeter.as_ref())
+            .ok_or("split VT: presentation greeter is no longer tracked")?;
+        if !Arc::ptr_eq(&current.command, &greeter.command) {
+            return Err("split VT: tracked greeter changed before presentation".into());
+        }
+        let active = inner
+            .active_split
+            .as_mut()
+            .ok_or("split VT: no pending RETURN")?;
+        if !Arc::ptr_eq(&active.binding.return_switch, &attempt) {
+            return Err("split VT: return attempt changed before presentation".into());
+        }
+        greeter.require_presented_session(vts, &pam)?;
+        peer.alive()?;
+        request.check()?;
+        active
+            .return_presentation
+            .take()
+            .ok_or("split VT: no pending greeter presentation")?
+            .received
+            .send(())
+            .map_err(|_| "split VT: return no longer awaits presentation".into())
+    }
+
+    async fn serve_return(
+        &self,
+        stream: UnixStream,
+        desktop: Arc<Desktop>,
+        mut ended: watch::Receiver<()>,
+        reconciled: oneshot::Sender<bool>,
+    ) {
+        let result = tokio::select! {
+            biased;
+            _ = ended.changed() => Ok(false),
+            result = split_vt::return_exchange(stream, |request| self.return_to_greeter(&desktop, request)) => result,
+        };
+        if let Some(active) = self.inner.write().await.active_split.as_mut() {
+            if Arc::ptr_eq(&active.binding, &desktop) {
+                active.return_presentation = None;
+            }
+        }
+        let acknowledged = matches!(&result, Ok(true));
+        if let Err(e) = result {
+            eprintln!("split VT: orderly RETURN failed: {}", e);
+        }
+        let Some(vts) = &self.split_vts else { return };
+        let allowed = !acknowledged
+            && match desktop
+                .return_switch
+                .clone()
+                .allow_return_recovery(vts)
+                .await
+            {
+                Ok(allowed) => allowed,
+                Err(e) => {
+                    eprintln!("split VT: could not reconcile return activation: {}", e);
+                    false
+                }
+            };
+        let allowed = if allowed {
+            // Preserve a late switch, or an operator VT, until the worker exits.
+            tokio::select! {
+                biased;
+                _ = split_vt::wait_foreground_change(vts.user, None) => false,
+                _ = ended.changed() => true,
+            }
+        } else {
+            false
+        };
+        let _ = reconciled.send(allowed);
+    }
+
+    async fn return_to_greeter(
+        &self,
+        desktop: &Arc<Desktop>,
+        request: ReturnRequest,
+    ) -> Result<(), Error> {
+        let vts = self.split_vts.as_ref().ok_or("split VT is not enabled")?;
+        tokio::select! {
+            biased;
+            err = split_vt::wait_foreground_change(vts.user, Some(vts.greeter)) => {
+                desktop.return_switch.inhibit_restore();
+                Err(err)
+            },
+            result = async {
+                desktop.check(vts)?;
+                desktop.require_active(vts)?;
+                desktop.peer.recheck(&desktop.pam).await?;
+                let greeter = self.ensure_split_greeter(vts, Some(&desktop.prior_greeter)).await?;
+                let greeter_pam = loop {
+                    request.check()?;
+                    desktop.require_active(vts)?;
+                    if let Some(pam) = greeter.pam(vts)? {
+                        if split_vt::graphics(vts.greeter)? {
+                            break pam;
+                        }
+                    }
+                    sleep(Duration::from_millis(25)).await;
+                };
+                let (received, presented) = oneshot::channel();
+                {
+                    let mut inner = self.inner.write().await;
+                    let active = inner.active_split.as_mut().filter(|a| Arc::ptr_eq(&a.binding, desktop))
+                        .ok_or("split VT: desktop exited during RETURN")?;
+                    request.check()?;
+                    active.return_presentation = Some(GreeterPresentation {
+                        greeter: greeter.clone(),
+                        pam: greeter_pam.clone(),
+                        request: request.clone(),
+                        received,
+                    });
+                }
+                let tracked = greeter.clone();
+                let switch_desktop = desktop.clone();
+                let switch_vts = vts.clone();
+                let switch_request = request.clone();
+                let activation = desktop.return_switch.clone().activate(greeter_pam.clone(), move |target| {
+                    switch_request.check()?;
+                    switch_desktop.peer.verify(&switch_desktop.pam)?;
+                    switch_desktop.check(&switch_vts)?;
+                    if tracked.pam(&switch_vts)?.as_ref() != Some(target) {
+                        return Err("split VT: prepared greeter PAM session changed".into());
+                    }
+                    logind::require_exclusive_vt(switch_vts.greeter, target)?;
+                    if !split_vt::graphics(switch_vts.greeter)? || target.active()? {
+                        return Err("split VT: greeter is not an inactive graphics session".into());
+                    }
+                    switch_desktop.require_active(&switch_vts)?;
+                    switch_request.check()
+                }).await;
+                if !desktop.return_switch.requested() {
+                    activation?;
+                }
+                // A delivered activation can succeed without a bus reply. Only
+                // the authenticated presentation can complete the exchange.
+                presented.await.map_err(|_| "split VT: greeter presentation channel closed")?;
+                request.check()?;
+                desktop.check(vts)?;
+                greeter.require_presented_session(vts, &greeter_pam)
+            } => result,
+        }
+    }
+
+    async fn recover_split(&self, owner: Option<logind::Session>) {
+        let Some(vts) = &self.split_vts else {
+            return;
+        };
+        {
+            let mut inner = self.inner.write().await;
+            if inner.recovering_split
+                || inner.active_split.is_some()
+                || inner.pending_split.is_some()
+            {
+                return;
+            }
+            inner.recovering_split = true;
+        }
+        self.finish_split_recovery(vts, owner).await;
+    }
+
+    async fn finish_split_recovery(&self, vts: &Vts, mut owner: Option<logind::Session>) {
+        let launch = timeout(Duration::from_secs(2), self.ensure_split_greeter(vts, None));
+        tokio::pin!(launch);
+        let started = tokio::select! {
+            biased;
+            _ = split_vt::wait_foreground_change(vts.user, None), if owner.is_some() => {
+                owner = None;
+                launch.await
+            }
+            started = &mut launch => started,
+        };
+        match started {
+            Ok(Ok(greeter)) => {
+                if let Some(owner) = owner {
+                    if let Err(e) = self.restore_split_greeter(vts, &greeter, owner).await {
+                        eprintln!("split VT: greeter foreground recovery failed: {}", e);
+                    }
+                }
+                self.inner.write().await.recovering_split = false;
+            }
+            Ok(Err(e)) => {
+                self.split_failure.send_replace(Some(
+                    format!("split VT: greeter recovery failed: {}", e).into(),
+                ));
+            }
+            Err(_) => {
+                self.split_failure
+                    .send_replace(Some("split VT: replacement greeter start timed out".into()));
+            }
+        }
+    }
+
+    async fn restore_split_greeter(
+        &self,
+        vts: &Vts,
+        greeter: &SplitGreeter,
+        owner: logind::Session,
+    ) -> Result<(), Error> {
+        let prepared = timeout(Duration::from_secs(2), async {
+            while split_vt::foreground()? == vts.user {
+                if greeter.pam(vts)?.is_some() && split_vt::graphics(vts.greeter)? {
+                    return Ok::<_, Error>(true);
+                }
+                sleep(Duration::from_millis(25)).await;
+            }
+            Ok(false)
+        })
+        .await;
+        if prepared.map_err(|_| "split VT: recovery greeter did not enter graphics mode")?? {
+            vts.restore(greeter.pid.as_raw(), greeter.worker.clone(), Some(owner))
+                .await?;
+        }
+        Ok(())
+    }
+
+    async fn check_split_child(self: &std::rc::Rc<Self>, pid: nix::unistd::Pid) {
+        let recovery = {
+            let mut inner = self.inner.write().await;
+            if inner
+                .current
+                .as_ref()
+                .map_or(false, |s| s.child.owns_pid(pid))
+            {
+                let early = inner.current.take().unwrap().time.elapsed() < Duration::from_secs(1);
+                if let Some(mut setting) = inner.configuring.take() {
+                    let _ = setting.session.cancel().await;
+                }
+                if let Some(pending) = &inner.pending_split {
+                    pending.abort.send_replace(true);
+                    return;
+                }
+                if inner.active_split.is_some() {
+                    return;
+                }
+                if early || inner.recovering_split {
+                    inner.recovering_split = true;
