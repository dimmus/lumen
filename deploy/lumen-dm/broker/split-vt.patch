+
+pub const COMMAND: &str = "/usr/bin/lumen-session";
+const COMPOSITOR: &str = "/usr/bin/lumen-compositor";
+const DIRECTORY: &str = "/run/lumen-dm-handoff";
+const SO_PEERPIDFD: libc::c_int = 77;
+pub const HANDOFF_TIMEOUT: Duration = Duration::from_secs(10);
+const CHECK_INTERVAL: Duration = Duration::from_millis(25);
+const RETURN_TIMEOUT: Duration = Duration::from_secs(2);
+
+pub fn check_request(version: u32, cmd: &[String], env: &[String]) -> Result<(), Error> {
+    if version != 1 {
+        return Err("unsupported split VT protocol version".into());
+    }
+    if !(cmd.is_empty() || (cmd.len() == 1 && cmd[0] == COMMAND)) || !env.is_empty() {
+        return Err(
+            "split VT requires the installed lumen-session command and no IPC environment".into(),
+        );
+    }
+    Ok(())
+}
+
+fn trusted_file(path: &str) -> Result<fs::Metadata, Error> {
+    let meta = fs::metadata(path)?;
+    if !meta.is_file() || meta.uid() != 0 || meta.mode() & 0o022 != 0 || meta.mode() & 0o111 == 0 {
+        return Err(format!("split VT: untrusted executable {}", path).into());
+    }
+    Ok(meta)
+}
+
+pub fn require_free_vt(vt: usize) -> Result<(), Error> {
+    if Terminal::open("/dev/tty0")?.vt_is_open(vt)? || logind::vt_is_occupied(vt)? {
+        return Err(format!("split VT: VT{} is active or occupied", vt).into());
+    }
+    Ok(())
+}
+
+pub fn foreground() -> Result<usize, Error> {
+    Terminal::open("/dev/tty0")?.vt_get_current()
+}
+
+#[derive(Clone)]
+pub struct Vts {
+    pub greeter: usize,
+    pub user: usize,
+    pub greeter_uid: u32,
+}
+
+impl Vts {
+    pub fn new(greeter: usize, user: usize, greeter_uid: u32) -> Result<Self, Error> {
+        if user == greeter || greeter == 0 || user == 2 || !(1..=15).contains(&user) {
+            return Err("split VT requires a separate dedicated user VT (not VT2)".into());
+        }
+        require_free_vt(user)?;
+        trusted_file(COMMAND)?;
+        trusted_file(COMPOSITOR)?;
+        Ok(Self {
+            greeter,
+            user,
+            greeter_uid,
+        })
+    }
+
+    pub fn require_greeter(&self) -> Result<(), Error> {
+        if foreground()? != self.greeter {
+            return Err("split VT: greeter is no longer in the foreground".into());
+        }
+        Ok(())
+    }
+
+    pub async fn restore(
+        &self,
+        greeter_pid: libc::pid_t,
+        worker: Arc<PidFd>,
+        owner: Option<logind::Session>,
+    ) -> Result<(), Error> {
+        let (user_vt, greeter_vt, uid) = (self.user, self.greeter, self.greeter_uid);
+        tokio::task::spawn_blocking(move || {
+            if foreground()? != user_vt || logind::vt_has_other_session(user_vt, owner.as_ref())? {
+                return Ok(());
+            }
+            worker.alive()?;
+            let session = logind::Session::from_worker(greeter_pid, uid, greeter_vt)?;
+            session.activate_if(|| {
+                worker.alive()?;
+                logind::require_exclusive_vt(greeter_vt, &session)?;
+                if !graphics(greeter_vt)? {
+                    return Err("split VT: recovery greeter is not in KD_GRAPHICS".into());
+                }
+                if logind::vt_has_other_session(user_vt, owner.as_ref())?
+                    || foreground()? != user_vt
+                {
+                    return Err("split VT: foreground ownership changed during rollback".into());
+                }
+                Ok(())
+            })
+        })
+        .await
+        .map_err(|e| e.to_string())?
+    }
+}
+
+struct SocketPath(String);
+
+impl Drop for SocketPath {
+    fn drop(&mut self) {
+        let _ = fs::remove_file(&self.0);
+    }
+}
+
+pub struct Handoff {
+    listener: UnixListener,
+    path: SocketPath,
+    uid: u32,
+}
+
+fn random_nonce() -> Result<String, Error> {
+    use std::io::Read;
+    let mut random = [0u8; 16];
+    fs::File::open("/dev/urandom")?.read_exact(&mut random)?;
+    Ok(random.iter().map(|n| format!("{:02x}", n)).collect())
+}
+
+impl Handoff {
+    pub fn new(uid: u32) -> Result<Self, Error> {
+        if uid == 0 {
+            return Err("split VT does not accept root desktop sessions".into());
+        }
+        match DirBuilder::new().mode(0o711).create(DIRECTORY) {
+            Ok(()) => {}
+            Err(e) if e.kind() == io::ErrorKind::AlreadyExists => {}
+            Err(e) => return Err(e.into()),
+        }
+        let meta = fs::symlink_metadata(DIRECTORY)?;
+        if !meta.is_dir() || meta.uid() != 0 || meta.mode() & 0o777 != 0o711 {
+            return Err("split VT: handoff directory must be root-owned with mode 0711".into());
+        }
+        let name = random_nonce()?;
+        let path = format!("{}/{}.sock", DIRECTORY, name);
+        // No await between binding with 0700 and restoring greetd's normal umask.
+        let mask = unsafe { libc::umask(0o077) };
+        let listener = UnixListener::bind(&path);
+        unsafe { libc::umask(mask) };
+        let listener = listener?;
+        let path = SocketPath(path);
+        // Linux POSIX ACL xattr: root rw, this UID w, and no access for others.
+        // Keep owner root so the authenticated account cannot widen access.
+        let mut acl = vec![2, 0, 0, 0];
+        for (tag, perm, id) in [
+            (1u16, 6u16, u32::MAX),
+            (2, 2, uid),
+            (4, 0, u32::MAX),
+            (16, 2, u32::MAX),
+            (32, 0, u32::MAX),
+        ] {
+            acl.extend(tag.to_le_bytes());
+            acl.extend(perm.to_le_bytes());
+            acl.extend(id.to_le_bytes());
+        }
+        let socket_path = CString::new(path.0.as_str())?;
+        if unsafe {
+            libc::setxattr(
+                socket_path.as_ptr(),
+                cstr!("system.posix_acl_access").as_ptr(),
+                acl.as_ptr().cast(),
+                acl.len(),
+                0,
+            )
+        } != 0
+        {
+            return Err(format!(
+                "split VT: cannot restrict handoff socket: {}",
+                io::Error::last_os_error()
+            )
+            .into());
+        }
+        Ok(Self {
+            listener,
+            path,
+            uid,
+        })
+    }
+
+    pub fn path(&self) -> &str {
+        &self.path.0
+    }
+
+    pub async fn prepare(
+        &self,
+        pam: &logind::Session,
+        verified: &mut Option<Peer>,
+    ) -> Result<UnixStream, Error> {
+        let (mut stream, _) = self.listener.accept().await?;
+        let cred = stream.peer_cred()?;
+        let pid = cred
+            .pid()
+            .filter(|pid| *pid > 0)
+            .ok_or("missing compositor peer PID")?;
+        if cred.uid() != self.uid {
+            return Err("split VT: compositor peer UID did not authenticate".into());
+        }
+        let peer = Peer {
+            pid,
+            uid: self.uid,
+            path: self.path.0.clone(),
+            fd: PidFd::from_peer(&stream)?,
+        };
+        peer.recheck(pam).await?;
+        *verified = Some(peer);
+        read_message(&mut stream, b"PREPARED\n").await?;
+        Ok(stream)
+    }
+}
+
+fn verify_peer(pid: libc::pid_t, uid: u32, path: &str, pam: &logind::Session) -> Result<(), Error> {
+    logind::verify_service(pid, uid)?;
+    let proc_exe = format!("/proc/{}/exe", pid);
+    let exe = fs::metadata(&proc_exe)?;
+    let trusted = trusted_file(COMPOSITOR)?;
+    if fs::read_link(proc_exe)? != Path::new(COMPOSITOR)
+        || (exe.dev(), exe.ino()) != (trusted.dev(), trusted.ino())
+    {
+        return Err(
+            "split VT: compositor executable identity differs from the installed binary".into(),
+        );
+    }
+    let environment = fs::read(format!("/proc/{}/environ", pid))?;
+    let has = |name: &[u8], value: &[u8]| {
+        let mut matches = environment
+            .split(|b| *b == 0)
+            .filter_map(|entry| entry.strip_prefix(name));
+        matches.next() == Some(value) && matches.next().is_none()
+    };
+    if !has(b"XDG_SESSION_ID=", pam.id()) || !has(b"LUMEN_DM_HANDOFF=", path.as_bytes()) {
+        return Err(
+            "split VT: compositor unit is not bound to this PAM session and attempt".into(),
+        );
+    }
+    Ok(())
+}
