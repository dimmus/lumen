{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/.zcode/hooks/protect-generated-paths.sh\"",
              "timeoutMs": 10000,
              "statusMessage": "Generated-path protection check"
            }
          ]
        }
      ]
    }
  }
}
